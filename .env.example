# 19 JHR BN NCC Command Portal — Environment Variable Specification
# DO NOT ADD REAL SECRET VALUES TO THIS FILE. USE AS A TEMPLATE ONLY.
# SECURITY NOTICE: Variables starting with VITE_ are bundled into browser-delivered code!
# NEVER assign passwords, service role keys, or database credentials to VITE_ variables.

# ==============================================================================
# 1. CORE APPLICATION RUNTIME (REQUIRED)
# ==============================================================================
NODE_ENV=development
PORT=3000

# ==============================================================================
# 2. SUPABASE POSTGRESQL & AUTH (REQUIRED)
# ==============================================================================
# Public browser-safe credentials
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only administrative key (Bypasses RLS - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ==============================================================================
# 3. PRISMA 7 ORM & POSTGRESQL POOLING (REQUIRED FOR PRISMA / MIGRATIONS)
# ==============================================================================
# Pooled connection URL (Port 6543 with PgBouncer for server functions & queries)
DATABASE_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (Port 5432 for schema migrations and DDL)
DIRECT_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# PostgreSQL connection pool tuning (Optional)
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# ==============================================================================
# 4. SECURITY & CRYPTOGRAPHY SECRETS (REQUIRED)
# ==============================================================================
# Minimum 32-character high-entropy secret for signing JWTs
JWT_SECRET=your-256bit-jwt-secret-placeholder

# Minimum 32-byte secret for encrypting HttpOnly session cookies
SESSION_SECRET=your-session-secret-placeholder

# 32-byte hex key for Form 1 client-side draft encryption (Optional)
DRAFT_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-placeholder

# ==============================================================================
# 5. CACHING & RATE LIMITING (OPTIONAL — FALLS BACK TO IN-MEMORY LRU)
# ==============================================================================
# Option A: Local / Docker TCP Redis Connection
REDIS_URL=redis://localhost:6379

# Option B: Vercel / Cloud Upstash REST Redis Connection (Serverless deployment)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ==============================================================================
# 6. MONGODB ATLAS (OPTIONAL — SECONDARY LOGGING & ANALYTICS STORE)
# ==============================================================================
# Primary SRV Connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"

# Direct replica set URI (Optional fallback for Windows DNS querySrv ETIMEOUT issues)
# MONGODB_DIRECT_URI="mongodb://<username>:<password>@<shard-00>:27017,<shard-01>:27017/ncc_crm?ssl=true&replicaSet=<replica-name>&authSource=admin"

# Target MongoDB database name (default: ncc_crm)
MONGODB_DB_NAME=ncc_crm

# ==============================================================================
# 7. TRANSACTIONAL EMAIL DISPATCH (OPTIONAL — FALLS BACK TO CONSOLE LOGGER)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@sbu.ac.in
SMTP_PASS=your-smtp-app-password
SMTP_FROM="19 JHR BN NCC Portal <no-reply@sbu.ac.in>"

# ==============================================================================
# 8. REAL-TIME WEBSOCKETS & CLOUD STORAGE (OPTIONAL)
# ==============================================================================
VITE_WS_HOST=http://localhost:3000
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sbu-ncc-portal-assets

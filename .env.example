# Environment Configuration Template for 19 JHR BN NCC SBU Portal (NCC CRM V1.0)

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL 15 Container)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncc_db?schema=public"

# AI Assistant Integration (Google Gemini 2.5)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Frontend Microservice Network Pipeline Config
VITE_API_URL="http://localhost:3000/api/v1"
VITE_WS_HOST="localhost:3000"

# Application Public Host URL
APP_URL="http://localhost:3000"
